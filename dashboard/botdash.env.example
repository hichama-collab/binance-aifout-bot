# === FILE: dashboard/botdash.env.example ===
# Copy to botdash.env and fill in real values.
# NEVER commit botdash.env to version control.

# HTTP Basic Auth credentials for the dashboard
DASH_USER=admin
DASH_PASS=replace_with_long_random_password

# Optional token for POST API endpoints (X-Bot-Token header)
# If empty, falls back to Basic Auth
BOT_DASHBOARD_TOKEN=

# Flask session secret (generate with: python3 -c "import secrets; print(secrets.token_hex(32))")
FLASK_SECRET_KEY=generate_a_strong_random_secret_here

# Port the Flask app listens on (proxied by nginx)
DASH_PORT=8099
DASH_HOST=127.0.0.1

# Bot directory layout
BOT_BASE_DIR=/opt/binance-aifout-bot
BOT_LOG_DIR=/opt/binance-aifout-bot/data/logs
BOT_RUNTIME_DIR=/opt/binance-aifout-bot/data/runtime
BOT_SERVICE_ENV=/opt/binance-aifout-bot/.service.env
