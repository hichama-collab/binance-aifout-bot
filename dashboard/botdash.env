# Dashboard credentials (Basic Auth)
DASH_USER=admin
DASH_PASS=

# Bot paths
BOT_BASE_DIR=/opt/binance-aifout-bot
BOT_LOG_DIR=/opt/binance-aifout-bot/data/logs
BOT_RUNTIME_DIR=/opt/binance-aifout-bot/data/runtime
BOT_SERVICE_ENV=/opt/binance-aifout-bot/.service.env

# Dashboard port (nginx proxies to it)
DASH_PORT=8099
